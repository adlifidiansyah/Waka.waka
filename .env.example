# ---------------------------------------------------------------------------
# Supabase (required)
# ---------------------------------------------------------------------------
# Project Settings -> API in the Supabase dashboard, or the output of
# `supabase start` for local development.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only. The client portal resolves magic-link tokens with this, and the
# payment webhooks settle invoices with it. Never expose it to the browser and
# never prefix it with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
# Used to build the client portal links you hand out. Set this to your real
# origin in production or the links you copy will point at localhost.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Email (optional — Resend)
# ---------------------------------------------------------------------------
# Without these, the dashboard still mints portal links; it just can't send
# them, and the "email this link" option is disabled with a note saying why.
#
# API key: https://resend.com/api-keys
RESEND_API_KEY=

# The From address. The domain must be verified in Resend or every send is
# rejected. Include a display name so the client recognises the sender.
#   RESEND_FROM_EMAIL="Northlight Studio <portal@northlight.studio>"
RESEND_FROM_EMAIL=

# Optional: point the transport at a stub or an egress proxy. Leave unset in
# normal use.
# RESEND_ENDPOINT_OVERRIDE=

# Delivery events, so a bounced or complained-about address stops being mailed.
# Add a webhook in Resend pointing at  POST /api/webhooks/resend  with
# `email.bounced` and `email.complained` enabled, then paste its signing secret
# here. Without it, a dead address keeps receiving the whole reminder series.
RESEND_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# Scheduled sending (required for payment reminders)
# ---------------------------------------------------------------------------
# /api/cron/email works out which reminders are due and drains the outbox.
# It is a public URL that sends mail, so it refuses to run unless this is set
# and the caller presents it as `Authorization: Bearer <secret>`.
# Generate one with:  openssl rand -base64 32
# Vercel Cron sends its own bearer token; vercel.json already schedules it.
CRON_SECRET=

# ---------------------------------------------------------------------------
# Payments (optional)
# ---------------------------------------------------------------------------
# ClientDeck never holds funds. You paste a Stripe Payment Link or Midtrans
# Snap link onto a milestone invoice, and the provider's webhook flips that
# invoice to paid — which is what unlocks gated deliverables.
#
# Stripe: Developers -> Webhooks -> your endpoint -> Signing secret.
# Point the endpoint at  POST /api/webhooks/stripe  and send
# `checkout.session.completed`. Set the Payment Link's client_reference_id (or
# metadata.invoice_id) to the ClientDeck invoice id.
STRIPE_WEBHOOK_SECRET=

# Midtrans: Settings -> Access Keys -> Server Key.
# Point the payment notification URL at  POST /api/webhooks/midtrans  and use
# the invoice id as the order_id (or pass it in custom_field1).
MIDTRANS_SERVER_KEY=
